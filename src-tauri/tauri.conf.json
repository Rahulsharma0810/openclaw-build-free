{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "OpenClaw",
  "version": "0.1.0",
  "identifier": "com.openclaw.client",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    }
  },
  "app": {
    "windows": [
      {
        "title": "OpenClaw Client",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://*.ts.net:* https://*; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Rahulsharma0810/openclaw-build-free/releases/latest/download/update-manifest.json"
      ],
      "pubkey": "WILL_BE_GENERATED_AT_BUILD_TIME"
    }
  }
}
